{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "面向公开已发布文档的全文搜索与索引同步服务。",
        "title": "文档中心搜索服务 API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "description": "用于负载均衡与监控系统检测 Go 服务是否存活。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "系统"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.healthResponse"
                        }
                    }
                }
            }
        },
        "/internal/sync": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "文档存在且公开时写入索引；不存在、下架或菜单不可见时删除索引。仅限 Strapi 内网调用。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "内部同步"
                ],
                "summary": "同步单篇文档索引",
                "parameters": [
                    {
                        "description": "需要同步的文档标识",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.syncRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.syncResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        },
        "/search/list": {
            "post": {
                "description": "在标题和正文中搜索已发布且具有已发布菜单路径的文档。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "搜索"
                ],
                "summary": "搜索公开文档",
                "parameters": [
                    {
                        "description": "搜索条件与分页参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.searchListRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.searchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.errorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 400
                },
                "data": {},
                "message": {
                    "type": "string",
                    "example": "keyword is required"
                }
            }
        },
        "main.formattedSearchHit": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "string",
                    "example": "...使用 \u003cmark\u003e快速\u003c/mark\u003e开始完成配置..."
                },
                "title": {
                    "type": "string",
                    "example": "\u003cmark\u003e快速\u003c/mark\u003e开始"
                }
            }
        },
        "main.healthData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "main.healthResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.healthData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "main.pagination": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "pageSize": {
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "type": "string",
                    "example": "7"
                }
            }
        },
        "main.paginationRequest": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "pageSize": {
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "main.searchData": {
            "type": "object",
            "properties": {
                "list": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.searchHit"
                    }
                },
                "pagination": {
                    "$ref": "#/definitions/main.pagination"
                }
            }
        },
        "main.searchHit": {
            "type": "object",
            "properties": {
                "_formatted": {
                    "$ref": "#/definitions/main.formattedSearchHit"
                },
                "content": {
                    "type": "string",
                    "example": "完成产品配置的入门文档。"
                },
                "id": {
                    "type": "string",
                    "example": "quick-start"
                },
                "title": {
                    "type": "string",
                    "example": "快速开始"
                },
                "url": {
                    "type": "string",
                    "example": "/quick-start"
                }
            }
        },
        "main.searchListRequest": {
            "type": "object",
            "properties": {
                "keyword": {
                    "type": "string",
                    "example": "快速开始"
                },
                "pagination": {
                    "$ref": "#/definitions/main.paginationRequest"
                }
            }
        },
        "main.searchResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.searchData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "main.syncData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "synced"
                }
            }
        },
        "main.syncRequest": {
            "type": "object",
            "properties": {
                "docId": {
                    "type": "string"
                }
            }
        },
        "main.syncResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.syncData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "内部同步接口使用 Bearer Token 鉴权。",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}