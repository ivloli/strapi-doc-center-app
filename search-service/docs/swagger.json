{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "面向公开已发布文档的全文搜索与索引同步服务。",
        "title": "文档中心搜索服务 API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "description": "用于负载均衡与监控系统检测 Go 服务是否存活。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "系统"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.healthResponse"
                        }
                    }
                }
            }
        },
        "/internal/sync": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "文档变更时按 docId 同步单篇；菜单变更时按 menuValue 触发全量对账，确保可见性变化立即生效。仅限 Strapi 内网调用。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "内部同步"
                ],
                "summary": "同步单篇文档索引",
                "parameters": [
                    {
                        "description": "需要同步的文档标识",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.syncRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.syncResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        },
        "/search/list": {
            "post": {
                "description": "在标题和正文中搜索已发布且具有已发布菜单入口的文档。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "搜索"
                ],
                "summary": "搜索公开文档",
                "parameters": [
                    {
                        "description": "搜索条件与分页参数",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.searchListRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.searchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        },
        "/search/suggestions/list": {
            "post": {
                "description": "仅按文档标题匹配，不记录热门词或用户搜索行为。空关键词返回空列表。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "搜索"
                ],
                "summary": "获取搜索关键词建议",
                "parameters": [
                    {
                        "description": "输入关键词与返回数量",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.suggestionListRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.suggestionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/main.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.errorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 400
                },
                "data": {},
                "message": {
                    "type": "string",
                    "example": "keyword is required"
                }
            }
        },
        "main.healthData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "main.healthResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.healthData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "main.pagination": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "pageSize": {
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "type": "string",
                    "example": "7"
                }
            }
        },
        "main.paginationRequest": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "example": 1
                },
                "pageSize": {
                    "type": "integer",
                    "example": 20
                },
                "total": {
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "main.searchData": {
            "type": "object",
            "properties": {
                "list": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.searchHit"
                    }
                },
                "pagination": {
                    "$ref": "#/definitions/main.pagination"
                }
            }
        },
        "main.searchHighlight": {
            "type": "object",
            "properties": {
                "summary": {
                    "type": "string",
                    "example": "...使用 \u003cmark\u003e快速\u003c/mark\u003e开始完成配置..."
                },
                "title": {
                    "type": "string",
                    "example": "\u003cmark\u003e快速\u003c/mark\u003e开始"
                }
            }
        },
        "main.searchHit": {
            "type": "object",
            "properties": {
                "docId": {
                    "type": "string",
                    "example": "test-kirito"
                },
                "highlight": {
                    "$ref": "#/definitions/main.searchHighlight"
                },
                "id": {
                    "type": "string",
                    "example": "doc_9fd2d776b6a4521d685e27ede29f052003c8353455ec5341b3831089f14e1220"
                },
                "path": {
                    "type": "string",
                    "example": "/test-kirito"
                },
                "summary": {
                    "type": "string",
                    "example": "...使用快速开始完成配置..."
                },
                "title": {
                    "type": "string",
                    "example": "快速开始"
                },
                "url": {
                    "type": "string",
                    "example": "https://help.test.starviewcloud.com/test-kirito"
                }
            }
        },
        "main.searchListRequest": {
            "type": "object",
            "properties": {
                "appId": {
                    "type": "integer",
                    "example": 15
                },
                "keyword": {
                    "type": "string",
                    "example": "快速开始"
                },
                "pagination": {
                    "$ref": "#/definitions/main.paginationRequest"
                }
            }
        },
        "main.searchResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.searchData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "main.searchSuggestion": {
            "type": "object",
            "properties": {
                "docId": {
                    "type": "string",
                    "example": "test-kirito"
                },
                "highlight": {
                    "$ref": "#/definitions/main.suggestionHighlight"
                },
                "keyword": {
                    "type": "string",
                    "example": "域名管理"
                },
                "path": {
                    "type": "string",
                    "example": "/test-kirito"
                },
                "title": {
                    "type": "string",
                    "example": "域名防封使用说明"
                },
                "url": {
                    "type": "string",
                    "example": "https://help.test.starviewcloud.com/test-kirito"
                }
            }
        },
        "main.suggestionData": {
            "type": "object",
            "properties": {
                "list": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.searchSuggestion"
                    }
                }
            }
        },
        "main.suggestionHighlight": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string",
                    "example": "域名\u003cmark\u003e管理\u003c/mark\u003e"
                }
            }
        },
        "main.suggestionListRequest": {
            "type": "object",
            "properties": {
                "appId": {
                    "type": "integer",
                    "example": 15
                },
                "keyword": {
                    "type": "string",
                    "example": "管理"
                },
                "limit": {
                    "type": "integer",
                    "example": 8
                }
            }
        },
        "main.suggestionResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.suggestionData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "main.syncData": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "synced"
                }
            }
        },
        "main.syncRequest": {
            "type": "object",
            "properties": {
                "docId": {
                    "type": "string"
                },
                "menuValue": {
                    "type": "string"
                }
            }
        },
        "main.syncResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer",
                    "example": 200
                },
                "data": {
                    "$ref": "#/definitions/main.syncData"
                },
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "内部同步接口使用 Bearer Token 鉴权。",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}