SEARCH_HOST=127.0.0.1
SEARCH_PORT=8080

# Use a dedicated role with SELECT access to docs and menus only.
DATABASE_URL=postgresql://search_reader:change_me@127.0.0.1:5432/strapi_docs?sslmode=disable

MEILI_URL=http://127.0.0.1:7700
# A non-master key restricted to this index: create/update settings, documents.*, and search.
MEILI_API_KEY=change_me_to_a_long_random_value
MEILI_INDEX=docs_public

# The lifecycle hook handles normal changes; reconciliation repairs missed events.
SYNC_INTERVAL=1h
SYNC_BATCH_SIZE=500
SYNC_ON_START=true

# Must match Strapi's SEARCH_SYNC_TOKEN. Keep this private; it authorizes POST /internal/sync.
SEARCH_SYNC_TOKEN=change_me_to_the_same_long_random_value_as_strapi
